<?xml version="1.0"?>
<Container version="2">
  <Name>hytale-server</Name>
  <Repository>indifferentbroccoli/hytale-server-docker:latest</Repository>
  <Registry>https://hub.docker.com/r/indifferentbroccoli/hytale-server-docker</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <Overview>A Docker container for running a Hytale dedicated server.</Overview>
  <Category>GameServers:</Category>
  <WebUI/>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/juddisjudd/unraid-templates/refs/heads/main/images/hytale.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID for file permissions" Type="Variable" Display="always" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID for file permissions" Type="Variable" Display="always" Required="false" Mask="false">100</Config>
  <Config Name="SERVER_NAME" Target="SERVER_NAME" Default="HytaleServer" Mode="" Description="Display name of the server" Type="Variable" Display="always" Required="true" Mask="false">HytaleServer</Config>
  <Config Name="MAX_PLAYERS" Target="MAX_PLAYERS" Default="20" Mode="" Description="Max players" Type="Variable" Display="always" Required="false" Mask="false">20</Config>
  <Config Name="VIEW_DISTANCE" Target="VIEW_DISTANCE" Default="12" Mode="" Description="View Distance" Type="Variable" Display="always" Required="false" Mask="false">12</Config>
  <Config Name="AUTH_MODE" Target="AUTH_MODE" Default="authenticated" Mode="" Description="Authentication Mode (authenticated|offline)" Type="Variable" Display="advanced" Required="false" Mask="false">authenticated</Config>
  <Config Name="Game Port" Target="5520" Default="5520" Mode="udp" Description="" Type="Port" Display="always" Required="true" Mask="false">5520</Config>
  <Config Name="Server Files" Target="/hytale" Default="/mnt/user/appdata/hytale" Mode="rw" Description="Hytale server files" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/hytale</Config>
</Container>
